{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy app + Mở Chrome",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "Mở Chrome localhost:5173",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://[^\\s]+)",
        "uriFormat": "%s"
      }
    }
  ]
}
