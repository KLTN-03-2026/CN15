# Kết nối tới PostgreSQL (database tạo và quản lý qua DBeaver)
# Không dùng file database trong ứng dụng - kiến trúc chuyên nghiệp
DATABASE_URL="postgresql://postgres:MẬT_KHẨU@localhost:5432/smart_recycling_vi?schema=public"
JWT_SECRET="smart-recycling-jwt-secret-key-2024"
PORT=3001
UPLOAD_DIR=./uploads

# OpenAI API Key - để AI phân tích ảnh rác chính xác (GPT Vision)
# Lấy tại: https://platform.openai.com/api-keys
# Bỏ dấu # và thay sk-... bằng key thật
OPENAI_API_KEY=sk-your-key-here

# URL frontend (cho link đặt lại mật khẩu - mặc định localhost:5173)
# FRONTEND_URL=http://localhost:5173
